# Copy to `.env` for local `npm run dev` signup testing (do not commit `.env`).
# Also set these in Vercel → Project → Settings → Environment Variables
# (Production + Preview).

# Required — create free key at https://web3forms.com while signed in as gamedaytools@gmail.com
WEB3FORMS_ACCESS_KEY=

# Optional — defaults to gamedaytools@gmail.com
SIGNUP_TO_EMAIL=gamedaytools@gmail.com
